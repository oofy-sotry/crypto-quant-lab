SECRET_KEY=change-me
DATABASE_URL=postgres://cryptoquant:cryptoquant@127.0.0.1:5432/cryptoquant
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 운영(Vercel) 전용: 로컬에서는 필요 없음 ----
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=.vercel.app
# DATABASE_URL=postgres://...-pooler....neon.tech/neondb?sslmode=require  (Neon 풀러 주소. migrate·loaddata는 풀러 없는 직접 주소로)
# DISABLE_SERVER_SIDE_CURSORS=True  (풀러 트랜잭션 모드에서 서버 쪽 커서가 깨지므로)
# CONN_MAX_AGE=0
# CRON_SECRET=...  (openssl rand -hex 32. Vercel Cron이 Authorization: Bearer 헤더로 보냄)
# ADMIN_API_TOKEN=...  (openssl rand -hex 32. 재처리 API용, Authorization: Bearer 헤더. 없으면 재처리 API 거부)
# MINUTE_RETENTION_DAYS=30  (분봉 보관 일수, 분봉 Cron이 그보다 오래된 분봉 삭제. 기본 0 = 지우지 않음)
# SLOW_QUERY_MS=200  (느린 쿼리 기준, 넘으면 경고 로그 + /api/ops/slow-queries/에 기록)
# SENTRY_DSN=https://...@....ingest.sentry.io/...  (없으면 Sentry 비활성)
# CORS_ALLOWED_ORIGINS=https://대시보드주소.vercel.app  (쉼표로 여러 개, 로컬 기본값 http://localhost:3000)
# DASHBOARD_URL=https://대시보드주소.vercel.app  (API 서버 / 접속 시 이동할 곳. 없으면 / 는 404)
# DASHBOARD_REVALIDATE_SECRET=...  (openssl rand -hex 32. 대시보드 REVALIDATE_SECRET과 같은 값. 수집 후 대시보드 캐시 즉시 갱신)
